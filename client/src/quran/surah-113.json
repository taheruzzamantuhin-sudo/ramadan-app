{"n":113,"bismillah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","ayahs":[{"i":1,"g":6226,"j":30,"ar":"قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ","bn":"বলুন, আমি আশ্রয় গ্রহণ করছি প্রভাতের পালনকর্তার,","pr":"কুল আ‘ঊযুবিরাব্বিল ফালাক"},{"i":2,"g":6227,"j":30,"ar":"مِن شَرِّ مَا خَلَقَ","bn":"তিনি যা সৃষ্টি করেছেন, তার অনিষ্ট থেকে,","pr":"মিন শাররি মা-খালাক।"},{"i":3,"g":6228,"j":30,"ar":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","bn":"অন্ধকার রাত্রির অনিষ্ট থেকে, যখন তা সমাগত হয়,","pr":"ওয়া মিন শাররি গা-ছিকিন ইযা-ওয়াকাব।"},{"i":4,"g":6229,"j":30,"ar":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِى ٱلْعُقَدِ","bn":"গ্রন্থিতে ফুঁৎকার দিয়ে জাদুকারিনীদের অনিষ্ট থেকে","pr":"ওয়া মিন শাররিন নাফফা-ছা-তি ফিল ‘উকাদ।"},{"i":5,"g":6230,"j":30,"ar":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","bn":"এবং হিংসুকের অনিষ্ট থেকে যখন সে হিংসা করে।","pr":"ওয়া মিন শাররি হা-ছিদিন ইযা-হাছাদ।"}]}