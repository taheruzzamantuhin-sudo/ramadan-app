{"n":87,"bismillah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","ayahs":[{"i":1,"g":5949,"j":30,"ar":"سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى","bn":"আপনি আপনার মহান পালনকর্তার নামের পবিত্রতা বর্ণনা করুন","pr":"ছাব্বিহিছমা রাব্বিকাল আ‘লা-।"},{"i":2,"g":5950,"j":30,"ar":"ٱلَّذِى خَلَقَ فَسَوَّىٰ","bn":"যিনি সৃষ্টি করেছেন ও সুবিন্যস্ত করেছেন।","pr":"আল্লাযী খালাকা ফাছওওয়া-।"},{"i":3,"g":5951,"j":30,"ar":"وَٱلَّذِى قَدَّرَ فَهَدَىٰ","bn":"এবং যিনি সুপরিমিত করেছেন ও পথ প্রদর্শন করেছেন","pr":"ওয়াল্লাযী কাদ্দারা ফাহাদা-।"},{"i":4,"g":5952,"j":30,"ar":"وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ","bn":"এবং যিনি তৃণাদি উৎপন্ন করেছেন,","pr":"ওয়াল্লাযীআখরাজাল মার‘আ-।"},{"i":5,"g":5953,"j":30,"ar":"فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ","bn":"অতঃপর করেছেন তাকে কাল আবর্জনা।","pr":"ফাজা‘আলাহূগুছাআন আহওয়া-।"},{"i":6,"g":5954,"j":30,"ar":"سَنُقْرِئُكَ فَلَا تَنسَىٰٓ","bn":"আমি আপনাকে পাঠ করাতে থাকব, ফলে আপনি বিস্মৃত হবেন না","pr":"ছানুকরিউকা ফালা-তানছা-।"},{"i":7,"g":5955,"j":30,"ar":"إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ","bn":"আল্লাহ যা ইচ্ছা করেন তা ব্যতীত। নিশ্চয় তিনি জানেন প্রকাশ্য ও গোপন বিষয়।","pr":"ইল্লা-মা-শাআল্লা-হু ইন্নাহূইয়া‘লামুল জাহরা ওয়ামা-ইয়াখফা-।"},{"i":8,"g":5956,"j":30,"ar":"وَنُيَسِّرُكَ لِلْيُسْرَىٰ","bn":"আমি আপনার জন্যে সহজ শরীয়ত সহজতর করে দেবো।","pr":"ওয়া নুইয়াছছিরুকা লিল ইউছরা-।"},{"i":9,"g":5957,"j":30,"ar":"فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ","bn":"উপদেশ ফলপ্রসূ হলে উপদেশ দান করুন,","pr":"ফাযাক্কির ইন নাফা‘আতিযযিকরা-।"},{"i":10,"g":5958,"j":30,"ar":"سَيَذَّكَّرُ مَن يَخْشَىٰ","bn":"যে ভয় করে, সে উপদেশ গ্রহণ করবে,","pr":"ছাইয়াযযাক্কারু মাইঁ ইয়াখশা-।"},{"i":11,"g":5959,"j":30,"ar":"وَيَتَجَنَّبُهَا ٱلْأَشْقَى","bn":"আর যে, হতভাগা, সে তা উপেক্ষা করবে,","pr":"ওয়া ইয়াতাজান্নাবুহাল আশকা-।"},{"i":12,"g":5960,"j":30,"ar":"ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ","bn":"সে মহা-অগ্নিতে প্রবেশ করবে।","pr":"আল্লাযী ইয়াসলান্না-রাল কুবরা-।"},{"i":13,"g":5961,"j":30,"ar":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ","bn":"অতঃপর সেখানে সে মরবেও না, জীবিতও থাকবে না।","pr":"ছু ম্মা লা-ইয়ামূতুফীহা-ওয়ালা-ইয়াহইয়া-।"},{"i":14,"g":5962,"j":30,"ar":"قَدْ أَفْلَحَ مَن تَزَكَّىٰ","bn":"নিশ্চয় সাফল্য লাভ করবে সে, যে শুদ্ধ হয়","pr":"কাদ আফলাহা মান তাঝাকা-।"},{"i":15,"g":5963,"j":30,"ar":"وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ","bn":"এবং তার পালনকর্তার নাম স্মরণ করে, অতঃপর নামায আদায় করে।","pr":"ওয়া যাকারাছমা রাব্বিহী ফাসাল্লা-।"},{"i":16,"g":5964,"j":30,"ar":"بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا","bn":"বস্তুতঃ তোমরা পার্থিব জীবনকে অগ্রাধিকার দাও,","pr":"বাল তু’ছিরূনাল হায়া-তাদ্দুনইয়া-।"},{"i":17,"g":5965,"j":30,"ar":"وَٱلْءَاخِرَةُ خَيْرٌۭ وَأَبْقَىٰٓ","bn":"অথচ পরকালের জীবন উৎকৃষ্ট ও স্থায়ী।","pr":"ওয়াল আ-খিরাতুখাইরুওঁ ওয়া আবকা-।"},{"i":18,"g":5966,"j":30,"ar":"إِنَّ هَٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ","bn":"এটা লিখিত রয়েছে পূর্ববতী কিতাবসমূহে;","pr":"ইন্না হা-যা-লাফিসসুহুফিল উলা-।"},{"i":19,"g":5967,"j":30,"ar":"صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ","bn":"ইব্রাহীম ও মূসার কিতাবসমূহে।","pr":"সুহুফি ইবরা-হীমা ওয়া মূছা।"}]}