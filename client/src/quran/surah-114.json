{"n":114,"bismillah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","ayahs":[{"i":1,"g":6231,"j":30,"ar":"قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","bn":"বলুন, আমি আশ্রয় গ্রহণ করিতেছি মানুষের পালনকর্তার,","pr":"কুল আ‘ঊযুবিরাব্বিন্না-ছ,"},{"i":2,"g":6232,"j":30,"ar":"مَلِكِ ٱلنَّاسِ","bn":"মানুষের অধিপতির,","pr":"মালিকিন্না-ছ,"},{"i":3,"g":6233,"j":30,"ar":"إِلَٰهِ ٱلنَّاسِ","bn":"মানুষের মা’বুদের","pr":"ইলা-হিন্না-ছ।"},{"i":4,"g":6234,"j":30,"ar":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","bn":"তার অনিষ্ট থেকে, যে কুমন্ত্রণা দেয় ও আত্নগোপন করে,","pr":"মিন শাররিল ওয়াছ ওয়া-ছিল খান্না-ছ।"},{"i":5,"g":6235,"j":30,"ar":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","bn":"যে কুমন্ত্রণা দেয় মানুষের অন্তরে","pr":"আল্লাযী ইউওয়াছবিছুফী সুদূরিন্নাছ-।"},{"i":6,"g":6236,"j":30,"ar":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","bn":"জ্বিনের মধ্য থেকে অথবা মানুষের মধ্য থেকে।","pr":"মিনাল জিন্নাতি ওয়ান্না-ছ।"}]}