{"n":102,"bismillah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","ayahs":[{"i":1,"g":6169,"j":30,"ar":"أَلْهَىٰكُمُ ٱلتَّكَاثُرُ","bn":"প্রাচুর্যের লালসা তোমাদেরকে গাফেল রাখে,","pr":"আলহা-কুমুত্তাকা-ছু র।"},{"i":2,"g":6170,"j":30,"ar":"حَتَّىٰ زُرْتُمُ ٱلْمَقَابِرَ","bn":"এমনকি, তোমরা কবরস্থানে পৌছে যাও।","pr":"হাত্তা-ঝুরতুমুল মাকা-বির।"},{"i":3,"g":6171,"j":30,"ar":"كَلَّا سَوْفَ تَعْلَمُونَ","bn":"এটা কখনও উচিত নয়। তোমরা সত্ত্বরই জেনে নেবে।","pr":"কাল্লা-ছাওফা তা‘লামূন।"},{"i":4,"g":6172,"j":30,"ar":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","bn":"অতঃপর এটা কখনও উচিত নয়। তোমরা সত্ত্বরই জেনে নেবে।","pr":"ছু ম্মা কাল্লা-ছাওফা তা‘লামূন।"},{"i":5,"g":6173,"j":30,"ar":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ ٱلْيَقِينِ","bn":"কখনই নয়; যদি তোমরা নিশ্চিত জানতে।","pr":"কাল্লা-লাও তা‘লামূনা ‘ইলমাল ইয়াকীন।"},{"i":6,"g":6174,"j":30,"ar":"لَتَرَوُنَّ ٱلْجَحِيمَ","bn":"তোমরা অবশ্যই জাহান্নাম দেখবে,","pr":"লাতারাউন্নাল জাহীমা"},{"i":7,"g":6175,"j":30,"ar":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ ٱلْيَقِينِ","bn":"অতঃপর তোমরা তা অবশ্যই দেখবে দিব্য প্রত্যয়ে,","pr":"ছু ম্মা লাতারাউন্নাহা-‘আইনাল ইয়াকীন।"},{"i":8,"g":6176,"j":30,"ar":"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ ٱلنَّعِيمِ","bn":"এরপর অবশ্যই সেদিন তোমরা নেয়ামত সম্পর্কে জিজ্ঞাসিত হবে।","pr":"ছু ম্মা লাতুছআলুন্না ইয়াওমাইযিন ‘আনিন্না‘ঈম।"}]}