{"n":96,"bismillah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","ayahs":[{"i":1,"g":6107,"j":30,"ar":"ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ","bn":"পাঠ করুন আপনার পালনকর্তার নামে যিনি সৃষ্টি করেছেন","pr":"ইকরা বিছমি রাব্বিকাল্লাযী খালাক।"},{"i":2,"g":6108,"j":30,"ar":"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ","bn":"সৃষ্টি করেছেন মানুষকে জমাট রক্ত থেকে।","pr":"খালাকাল ইনছা-না মিন ‘আলাক।"},{"i":3,"g":6109,"j":30,"ar":"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ","bn":"পাঠ করুন, আপনার পালনকর্তা মহা দয়ালু,","pr":"ইকরা’ ওয়া রাব্বুকাল আকরাম"},{"i":4,"g":6110,"j":30,"ar":"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ","bn":"যিনি কলমের সাহায্যে শিক্ষা দিয়েছেন,","pr":"অল্লাযী ‘আল্লামা বিলকালাম।"},{"i":5,"g":6111,"j":30,"ar":"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ","bn":"শিক্ষা দিয়েছেন মানুষকে যা সে জানত না।","pr":"‘আল্লামাল ইনছা-না-মা-লাম ইয়া‘লাম।"},{"i":6,"g":6112,"j":30,"ar":"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ","bn":"সত্যি সত্যি মানুষ সীমালংঘন করে,","pr":"কাল্লাইন্নাল ইনছা-না লাইয়াতগা।"},{"i":7,"g":6113,"j":30,"ar":"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ","bn":"এ কারণে যে, সে নিজেকে অভাবমুক্ত মনে করে।","pr":"আররাআ-হুছ তাগনা-।"},{"i":8,"g":6114,"j":30,"ar":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ","bn":"নিশ্চয় আপনার পালনকর্তার দিকেই প্রত্যাবর্তন হবে।","pr":"ইন্না ইলা-রাব্বিকার রুজ‘আ-।"},{"i":9,"g":6115,"j":30,"ar":"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ","bn":"আপনি কি তাকে দেখেছেন, যে নিষেধ করে","pr":"আরাআইতাল্লাযী ইয়ানহা-"},{"i":10,"g":6116,"j":30,"ar":"عَبْدًا إِذَا صَلَّىٰٓ","bn":"এক বান্দাকে যখন সে নামায পড়ে?","pr":"‘আবদান ইযা-সাল্লা-।"},{"i":11,"g":6117,"j":30,"ar":"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ","bn":"আপনি কি দেখেছেন যদি সে সৎপথে থাকে।","pr":"আরাআইতা ইন কা-না ‘আলাল হুদা।"},{"i":12,"g":6118,"j":30,"ar":"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ","bn":"অথবা খোদাভীতি শিক্ষা দেয়।","pr":"আও আমারা বিত্তাকাওয়া-।"},{"i":13,"g":6119,"j":30,"ar":"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","bn":"আপনি কি দেখেছেন, যদি সে মিথ্যারোপ করে ও মুখ ফিরিয়ে নেয়।","pr":"আরাআইতা ইন কাযযাবা ওয়া তাওয়াল্লা-।"},{"i":14,"g":6120,"j":30,"ar":"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ","bn":"সে কি জানে না যে, আল্লাহ দেখেন?","pr":"আলাম ইয়া‘লাম বিআন্নাল্লা-হা ইয়ারা-।"},{"i":15,"g":6121,"j":30,"ar":"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ","bn":"কখনই নয়, যদি সে বিরত না হয়, তবে আমি মস্তকের সামনের কেশগুচ্ছ ধরে হেঁচড়াবই-","pr":"কাল্লা-লাইল্লাম ইয়ানতাহি লানাছফা‘আম বিন্না-সিয়াহ।"},{"i":16,"g":6122,"j":30,"ar":"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ","bn":"মিথ্যাচারী, পাপীর কেশগুচ্ছ।","pr":"না-সিয়াতিন কা-যিবাতিন খা-তিআহ।"},{"i":17,"g":6123,"j":30,"ar":"فَلْيَدْعُ نَادِيَهُۥ","bn":"অতএব, সে তার সভাসদদেরকে আহবান করুক।","pr":"ফালইয়াদ‘উ নাদিয়াহ,"},{"i":18,"g":6124,"j":30,"ar":"سَنَدْعُ ٱلزَّبَانِيَةَ","bn":"আমিও আহবান করব জাহান্নামের প্রহরীদেরকে","pr":"ছানাদ‘উঝঝাবা-নিয়াহ।"},{"i":19,"g":6125,"j":30,"ar":"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩","bn":"কখনই নয়, আপনি তার আনুগত্য করবেন না। আপনি সেজদা করুন ও আমার নৈকট্য অর্জন করুন।","pr":"কাল্লা- লা-তুতি‘হু ওয়াছজু দ ওয়াকতারিব (ছিজদাহ-১৪)।"}]}