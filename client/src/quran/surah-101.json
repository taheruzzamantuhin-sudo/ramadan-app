{"n":101,"bismillah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","ayahs":[{"i":1,"g":6158,"j":30,"ar":"ٱلْقَارِعَةُ","bn":"করাঘাতকারী,","pr":"আল কা-রি‘আহ ।"},{"i":2,"g":6159,"j":30,"ar":"مَا ٱلْقَارِعَةُ","bn":"করাঘাতকারী কি?","pr":"মাল কা-রি‘আহ।"},{"i":3,"g":6160,"j":30,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","bn":"করাঘাতকারী সম্পর্কে আপনি কি জানেন ?","pr":"ওয়ামাআদরা-কা মাল কা-রি‘আহ।"},{"i":4,"g":6161,"j":30,"ar":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","bn":"যেদিন মানুষ হবে বিক্ষিপ্ত পতংগের মত","pr":"ইয়াওমা ইয়াকূনুন্না-ছুকাল ফারা-শিল মাবছূছ।"},{"i":5,"g":6162,"j":30,"ar":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","bn":"এবং পর্বতমালা হবে ধুনিত রঙ্গীন পশমের মত।","pr":"ওয়া তাকূনুল জিবা-লুকাল‘ইহনিল মানফূশ।"},{"i":6,"g":6163,"j":30,"ar":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","bn":"অতএব যার পাল্লা ভারী হবে,","pr":"ফাআম্মা-মান ছাকুলাত মাওয়া-ঝীনুহূ।"},{"i":7,"g":6164,"j":30,"ar":"فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ","bn":"সে সুখীজীবন যাপন করবে।","pr":"ফাহুওয়া ফী ‘ঈশাতির রা-দিয়াহ।"},{"i":8,"g":6165,"j":30,"ar":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","bn":"আর যার পাল্লা হালকা হবে,","pr":"ওয়া আম্মা-মান খাফফাত মাওয়াঝীনুহূ"},{"i":9,"g":6166,"j":30,"ar":"فَأُمُّهُۥ هَاوِيَةٌۭ","bn":"তার ঠিকানা হবে হাবিয়া।","pr":"ফাউম্মুহূহা-বিইয়াহ।"},{"i":10,"g":6167,"j":30,"ar":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","bn":"আপনি জানেন তা কি?","pr":"ওয়ামাআদরা-কা মা-হিয়াহ।"},{"i":11,"g":6168,"j":30,"ar":"نَارٌ حَامِيَةٌۢ","bn":"প্রজ্জ্বলিত অগ্নি!","pr":"না-রুন হা-মিয়াহ।"}]}