{"n":107,"bismillah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","ayahs":[{"i":1,"g":6198,"j":30,"ar":"أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","bn":"আপনি কি দেখেছেন তাকে, যে বিচারদিবসকে মিথ্যা বলে?","pr":"আরাআইতাল্লাযী ইউকাযযি বুবিদ্দীন।"},{"i":2,"g":6199,"j":30,"ar":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","bn":"সে সেই ব্যক্তি, যে এতীমকে গলা ধাক্কা দেয়","pr":"ফাযা-লিকাল্লাযী ইয়াদু‘‘উল ইয়াতীম।"},{"i":3,"g":6200,"j":30,"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","bn":"এবং মিসকীনকে অন্ন দিতে উৎসাহিত করে না।","pr":"ওয়ালা-ইয়াহুদ্দু‘আলা-তা‘আ-মিল মিছকীন।"},{"i":4,"g":6201,"j":30,"ar":"فَوَيْلٌۭ لِّلْمُصَلِّينَ","bn":"অতএব দুর্ভোগ সেসব নামাযীর,","pr":"ফাওয়াইঁলুলিলল মুসাল্লীন।"},{"i":5,"g":6202,"j":30,"ar":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","bn":"যারা তাদের নামায সম্বন্ধে বে-খবর;","pr":"আল্লাযীনাহুম ‘আন সালা-তিহিমি ছা-হূন।"},{"i":6,"g":6203,"j":30,"ar":"ٱلَّذِينَ هُمْ يُرَآءُونَ","bn":"যারা তা লোক-দেখানোর জন্য করে","pr":"আল্লাযীনা হুম ইউরাঊনা।"},{"i":7,"g":6204,"j":30,"ar":"وَيَمْنَعُونَ ٱلْمَاعُونَ","bn":"এবং নিত্য ব্যবহার্য্য বস্তু অন্যকে দেয় না।","pr":"ওয়া ইয়ামনা‘ঊনাল মা-‘ঊন।"}]}