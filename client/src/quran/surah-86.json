{"n":86,"bismillah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","ayahs":[{"i":1,"g":5932,"j":30,"ar":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","bn":"শপথ আকাশের এবং রাত্রিতে আগমনকারীর।","pr":"ওয়াছ ছামাই ওয়াততা-রিক।"},{"i":2,"g":5933,"j":30,"ar":"وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ","bn":"আপনি জানেন, যে রাত্রিতে আসে সেটা কি?","pr":"ওয়া মাআদরা-কা মাত্তা-রিক।"},{"i":3,"g":5934,"j":30,"ar":"ٱلنَّجْمُ ٱلثَّاقِبُ","bn":"সেটা এক উজ্জ্বল নক্ষত্র।","pr":"আন্নাজমুছছা-কিব।"},{"i":4,"g":5935,"j":30,"ar":"إِن كُلُّ نَفْسٍۢ لَّمَّا عَلَيْهَا حَافِظٌۭ","bn":"প্রত্যেকের উপর একজন তত্ত্বাবধায়ক রয়েছে।","pr":"ইন কুল্লুনাফছিল লাম্মা-‘আলাইহা-হা-ফিজ।"},{"i":5,"g":5936,"j":30,"ar":"فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ","bn":"অতএব, মানুষের দেখা উচিত কি বস্তু থেকে সে সৃজিত হয়েছে।","pr":"ফালইয়ানযুরিল ইনছা-নুমিম্মা খুলিক।"},{"i":6,"g":5937,"j":30,"ar":"خُلِقَ مِن مَّآءٍۢ دَافِقٍۢ","bn":"সে সৃজিত হয়েছে সবেগে স্খলিত পানি থেকে।","pr":"খুলিকা মিম্মাইন দা-ফিকি।"},{"i":7,"g":5938,"j":30,"ar":"يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ","bn":"এটা নির্গত হয় মেরুদন্ড ও বক্ষপাজরের মধ্য থেকে।","pr":"ইয়াখরুজুমিম বাইনিসসুলবি ওয়াত্তারাইব।"},{"i":8,"g":5939,"j":30,"ar":"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌۭ","bn":"নিশ্চয় তিনি তাকে ফিরিয়ে নিতে সক্ষম।","pr":"ইন্নাহূ‘আলা-রাজ‘ইহী লাকা-দির।"},{"i":9,"g":5940,"j":30,"ar":"يَوْمَ تُبْلَى ٱلسَّرَآئِرُ","bn":"যেদিন গোপন বিষয়াদি পরীক্ষিত হবে,","pr":"ইয়াওমা তুবলাছ ছারাইর।"},{"i":10,"g":5941,"j":30,"ar":"فَمَا لَهُۥ مِن قُوَّةٍۢ وَلَا نَاصِرٍۢ","bn":"সেদিন তার কোন শক্তি থাকবে না এবং সাহায্যকারীও থাকবে না।","pr":"ফামা-লাহূমিন কুওওয়াতিওঁ ওয়ালা-না-সির।"},{"i":11,"g":5942,"j":30,"ar":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ","bn":"শপথ চক্রশীল আকাশের","pr":"ওয়াছ ছামাই যা-তির রাজ‘ই।"},{"i":12,"g":5943,"j":30,"ar":"وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ","bn":"এবং বিদারনশীল পৃথিবীর","pr":"ওয়াল আরদিযা-তিসসাদ‘ই।"},{"i":13,"g":5944,"j":30,"ar":"إِنَّهُۥ لَقَوْلٌۭ فَصْلٌۭ","bn":"নিশ্চয় কোরআন সত্য-মিথ্যার ফয়সালা।","pr":"ইন্নাহূলাকাওলুন ফাসল।"},{"i":14,"g":5945,"j":30,"ar":"وَمَا هُوَ بِٱلْهَزْلِ","bn":"এবং এটা উপহাস নয়।","pr":"ওয়ামা-হুওয়া বিল হাঝলি।"},{"i":15,"g":5946,"j":30,"ar":"إِنَّهُمْ يَكِيدُونَ كَيْدًۭا","bn":"তারা ভীষণ চক্রান্ত করে,","pr":"ইন্নাহুম ইয়াকীদূনা কাইদাওঁ।"},{"i":16,"g":5947,"j":30,"ar":"وَأَكِيدُ كَيْدًۭا","bn":"আর আমিও কৌশল করি।","pr":"ওয়া আকীদুকাইদা-।"},{"i":17,"g":5948,"j":30,"ar":"فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا","bn":"অতএব, কাফেরদেরকে অবকাশ দিন, তাদেরকে অবকাশ দিন, কিছু দিনের জন্যে।","pr":"ফামাহহিলিল কা-ফিরীনা আমহিলহুম রুওয়াইদা-।"}]}