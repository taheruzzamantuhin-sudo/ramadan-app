{"n":88,"bismillah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","ayahs":[{"i":1,"g":5968,"j":30,"ar":"هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ","bn":"আপনার কাছে আচ্ছন্নকারী কেয়ামতের বৃত্তান্ত পৌঁছেছে কি?","pr":"হাল আতা-কা হাদীছুল গা-শিয়াহ।"},{"i":2,"g":5969,"j":30,"ar":"وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ","bn":"অনেক মুখমন্ডল সেদিন হবে লাঞ্ছিত,","pr":"উজূহুইঁ ইয়াওমাইযিন খা-শি‘আহ।"},{"i":3,"g":5970,"j":30,"ar":"عَامِلَةٌۭ نَّاصِبَةٌۭ","bn":"ক্লিষ্ট, ক্লান্ত।","pr":"‘আ-মিলাতুন না-সিবাহ।"},{"i":4,"g":5971,"j":30,"ar":"تَصْلَىٰ نَارًا حَامِيَةًۭ","bn":"তারা জ্বলন্ত আগুনে পতিত হবে।","pr":"তাসলা-না-রান হা-মিয়াহ।"},{"i":5,"g":5972,"j":30,"ar":"تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ","bn":"তাদেরকে ফুটন্ত নহর থেকে পান করানো হবে।","pr":"তুছকা-মিন ‘আইনিন আ-নিয়াহ।"},{"i":6,"g":5973,"j":30,"ar":"لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ","bn":"কন্টকপূর্ণ ঝাড় ব্যতীত তাদের জন্যে কোন খাদ্য নেই।","pr":"লাইছা লাহুম তা‘আ-মুন ইল্লা-মিন দারী‘ই।"},{"i":7,"g":5974,"j":30,"ar":"لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ","bn":"এটা তাদেরকে পুষ্ট করবে না এবং ক্ষুধায়ও উপকার করবে না।","pr":"লা-ইউছমিনুওয়ালা-ইউগনী মিন জু‘ই।"},{"i":8,"g":5975,"j":30,"ar":"وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ","bn":"অনেক মুখমন্ডল সেদিন হবে, সজীব,","pr":"উজূহুইঁ ইয়াওমাইযিন না-‘ইমাহ।"},{"i":9,"g":5976,"j":30,"ar":"لِّسَعْيِهَا رَاضِيَةٌۭ","bn":"তাদের কর্মের কারণে সন্তুষ্ট।","pr":"লিছা‘ইহা-রা-দিয়াহ।"},{"i":10,"g":5977,"j":30,"ar":"فِى جَنَّةٍ عَالِيَةٍۢ","bn":"তারা থাকবে, সুউচ্চ জান্নাতে।","pr":"ফী জান্নাতিন ‘আ-লিয়াহ।"},{"i":11,"g":5978,"j":30,"ar":"لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ","bn":"তথায় শুনবে না কোন অসার কথাবার্তা।","pr":"লা-তাছমা‘উ ফীহা-লা-গিয়াহ।"},{"i":12,"g":5979,"j":30,"ar":"فِيهَا عَيْنٌۭ جَارِيَةٌۭ","bn":"তথায় থাকবে প্রবাহিত ঝরণা।","pr":"ফীহা-‘আইনুন জা-রিয়াহ।"},{"i":13,"g":5980,"j":30,"ar":"فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ","bn":"তথায় থাকবে উন্নত সুসজ্জিত আসন।","pr":"ফীহা-ছুরুরুমমারফূ‘আহ।"},{"i":14,"g":5981,"j":30,"ar":"وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ","bn":"এবং সংরক্ষিত পানপাত্র","pr":"ওয়া আকওয়া-বুম মাওদূ‘আহ।"},{"i":15,"g":5982,"j":30,"ar":"وَنَمَارِقُ مَصْفُوفَةٌۭ","bn":"এবং সারি সারি গালিচা","pr":"ওয়া নামা-রিকুমাসফূফাহ।"},{"i":16,"g":5983,"j":30,"ar":"وَزَرَابِىُّ مَبْثُوثَةٌ","bn":"এবং বিস্তৃত বিছানো কার্পেট।","pr":"ওয়া ঝারা-বিইয়ুমাবছূছাহ।"},{"i":17,"g":5984,"j":30,"ar":"أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ","bn":"তারা কি উষ্ট্রের প্রতি লক্ষ্য করে না যে, তা কিভাবে সৃষ্টি করা হয়েছে?","pr":"আফালা-ইয়ানজু রুনা ইলাল ইবিলি কাইফা খুলিকাত।"},{"i":18,"g":5985,"j":30,"ar":"وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ","bn":"এবং আকাশের প্রতি লক্ষ্য করে না যে, তা কিভাবে উচ্চ করা হয়েছে?","pr":"ওয়া ইলাছ ছামাই কাইফা রুফি‘আত।"},{"i":19,"g":5986,"j":30,"ar":"وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ","bn":"এবং পাহাড়ের দিকে যে, তা কিভাবে স্থাপন করা হয়েছে?","pr":"ওয়া ইলাল জিবা-লি কাইফা নুসিবাত।"},{"i":20,"g":5987,"j":30,"ar":"وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ","bn":"এবং পৃথিবীর দিকে যে, তা কিভাবে সমতল বিছানো হয়েছে?","pr":"ওয়া ইলাল আরদি কাইফা ছুতিহাত।"},{"i":21,"g":5988,"j":30,"ar":"فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ","bn":"অতএব, আপনি উপদেশ দিন, আপনি তো কেবল একজন উপদেশদাতা,","pr":"ফাযাক্কির ইন্নামাআনতা মুযাক্কির।"},{"i":22,"g":5989,"j":30,"ar":"لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ","bn":"আপনি তাদের শাসক নন,","pr":"লাছাতা ‘আলইহিম বিমুসাইতির।"},{"i":23,"g":5990,"j":30,"ar":"إِلَّا مَن تَوَلَّىٰ وَكَفَرَ","bn":"কিন্তু যে মুখ ফিরিয়ে নেয় ও কাফের হয়ে যায়,","pr":"ইল্লা-মান তাওয়াল্লা-ওয়া কাফার।"},{"i":24,"g":5991,"j":30,"ar":"فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ","bn":"আল্লাহ তাকে মহা আযাব দেবেন।","pr":"ফাইউ‘আযযিবুহুল্লা-হুল ‘আযা-বাল আকবার।"},{"i":25,"g":5992,"j":30,"ar":"إِنَّ إِلَيْنَآ إِيَابَهُمْ","bn":"নিশ্চয় তাদের প্রত্যাবর্তন আমারই নিকট,","pr":"ইন্না ইলাইনাইয়া-বাহুম।"},{"i":26,"g":5993,"j":30,"ar":"ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم","bn":"অতঃপর তাদের হিসাব-নিকাশ আমারই দায়িত্ব।","pr":"ছু ম্মা ইন্না ‘আলাইনা-হিছা-বাহুম।"}]}