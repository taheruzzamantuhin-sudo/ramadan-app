{"n":108,"bismillah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","ayahs":[{"i":1,"g":6205,"j":30,"ar":"إِنَّآ أَعْطَيْنَٰكَ ٱلْكَوْثَرَ","bn":"নিশ্চয় আমি আপনাকে কাওসার দান করেছি।","pr":"ইন্নাআ‘তাইনা-কাল কাওছার।"},{"i":2,"g":6206,"j":30,"ar":"فَصَلِّ لِرَبِّكَ وَٱنْحَرْ","bn":"অতএব আপনার পালনকর্তার উদ্দেশ্যে নামায পড়ুন এবং কোরবানী করুন।","pr":"ফাসালিল লিরাব্বিকা ওয়ানহার।"},{"i":3,"g":6207,"j":30,"ar":"إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ","bn":"যে আপনার শত্রু, সেই তো লেজকাটা, নির্বংশ।","pr":"ইন্না শা-নিআকা হুওয়াল আবতার।"}]}