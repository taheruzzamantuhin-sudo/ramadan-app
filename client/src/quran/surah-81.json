{"n":81,"bismillah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","ayahs":[{"i":1,"g":5801,"j":30,"ar":"إِذَا ٱلشَّمْسُ كُوِّرَتْ","bn":"যখন সূর্য আলোহীন হয়ে যাবে,","pr":"ইযাশশামছুকুওবিরাত।"},{"i":2,"g":5802,"j":30,"ar":"وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ","bn":"যখন নক্ষত্র মলিন হয়ে যাবে,","pr":"ওয়া ইযাননুজূমুন কাদারাত।"},{"i":3,"g":5803,"j":30,"ar":"وَإِذَا ٱلْجِبَالُ سُيِّرَتْ","bn":"যখন পর্বতমালা অপসারিত হবে,","pr":"ওয়া ইযাল জিবা-লুছুইয়িরাত।"},{"i":4,"g":5804,"j":30,"ar":"وَإِذَا ٱلْعِشَارُ عُطِّلَتْ","bn":"যখন দশ মাসের গর্ভবতী উষ্ট্রীসমূহ উপেক্ষিত হবে;","pr":"ওয়া ইযাল ‘ইশা-রু ‘উত্তিলাত।"},{"i":5,"g":5805,"j":30,"ar":"وَإِذَا ٱلْوُحُوشُ حُشِرَتْ","bn":"যখন বন্য পশুরা একত্রিত হয়ে যাবে,","pr":"ওয়া ইযাল উহূশু হুশিরাত।"},{"i":6,"g":5806,"j":30,"ar":"وَإِذَا ٱلْبِحَارُ سُجِّرَتْ","bn":"যখন সমুদ্রকে উত্তাল করে তোলা হবে,","pr":"ওয়া ইযাল বিহা-রু ছুজ্জিরাত।"},{"i":7,"g":5807,"j":30,"ar":"وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ","bn":"যখন আত্মাসমূহকে যুগল করা হবে,","pr":"ওয়া ইযাননুফূছুঝুওবিজাত।"},{"i":8,"g":5808,"j":30,"ar":"وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ","bn":"যখন জীবন্ত প্রোথিত কন্যাকে জিজ্ঞেস করা হবে,","pr":"ওয়া ইযাল মাওঊদাতুছুইলাত।"},{"i":9,"g":5809,"j":30,"ar":"بِأَىِّ ذَنۢبٍۢ قُتِلَتْ","bn":"কি অপরাধে তাকে হত্য করা হল?","pr":"বিআইয়ি যামবিন কুতিলাত।"},{"i":10,"g":5810,"j":30,"ar":"وَإِذَا ٱلصُّحُفُ نُشِرَتْ","bn":"যখন আমলনামা খোলা হবে,","pr":"ওয়া ইযাসসুহুফুনুশিরাত।"},{"i":11,"g":5811,"j":30,"ar":"وَإِذَا ٱلسَّمَآءُ كُشِطَتْ","bn":"যখন আকাশের আবরণ অপসারিত হবে,","pr":"ওয়া ইয়াছ ছামাউ কুশিতাত।"},{"i":12,"g":5812,"j":30,"ar":"وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ","bn":"যখন জাহান্নামের অগ্নি প্রজ্বলিত করা হবে","pr":"ওয়া ইযাল জাহীমুছু‘‘য়িরাত।"},{"i":13,"g":5813,"j":30,"ar":"وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ","bn":"এবং যখন জান্নাত সন্নিকটবর্তী হবে,","pr":"ওয়া ইযাল জান্নাতুউঝলিফাত।"},{"i":14,"g":5814,"j":30,"ar":"عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ","bn":"তখন প্রত্যেকেই জেনে নিবে সে কি উপস্থিত করেছে।","pr":"‘আলিমাত নাফছুম মাআহদারাত।"},{"i":15,"g":5815,"j":30,"ar":"فَلَآ أُقْسِمُ بِٱلْخُنَّسِ","bn":"আমি 