{"n":100,"bismillah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","ayahs":[{"i":1,"g":6147,"j":30,"ar":"وَٱلْعَٰدِيَٰتِ ضَبْحًۭا","bn":"শপথ উর্ধ্বশ্বাসে চলমান অশ্বসমূহের,","pr":"ওয়াল ‘আ-দিয়া-তি দাবহা-।"},{"i":2,"g":6148,"j":30,"ar":"فَٱلْمُورِيَٰتِ قَدْحًۭا","bn":"অতঃপর ক্ষুরাঘাতে অগ্নিবিচ্ছুরক অশ্বসমূহের","pr":"ফাল মূরিয়া-তি কাদহা-।"},{"i":3,"g":6149,"j":30,"ar":"فَٱلْمُغِيرَٰتِ صُبْحًۭا","bn":"অতঃপর প্রভাতকালে আক্রমণকারী অশ্বসমূহের","pr":"ফাল মুগীরা-তি সুবহা-।"},{"i":4,"g":6150,"j":30,"ar":"فَأَثَرْنَ بِهِۦ نَقْعًۭا","bn":"ও যারা সে সময়ে ধুলি উৎক্ষিপ্ত করে","pr":"ফাআছারনা বিহী নাক‘আ-।"},{"i":5,"g":6151,"j":30,"ar":"فَوَسَطْنَ بِهِۦ جَمْعًا","bn":"অতঃপর যারা শক্রদলের অভ্যন্তরে ঢুকে পড়ে-","pr":"ফাওয়াছাতানা বিহী জাম‘আ-।"},{"i":6,"g":6152,"j":30,"ar":"إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ","bn":"নিশ্চয় মানুষ তার পালনকর্তার প্রতি অকৃতজ্ঞ।","pr":"ইন্নাল ইনছা-না লিরাব্বিহী লাকানূদ।"},{"i":7,"g":6153,"j":30,"ar":"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ","bn":"এবং সে অবশ্য এ বিষয়ে অবহিত","pr":"ওয়া ইন্নাহূ‘আলা-যা-লিকা লাশাহীদ।"},{"i":8,"g":6154,"j":30,"ar":"وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ","bn":"এবং সে নিশ্চিতই ধন-সম্পদের ভালবাসায় মত্ত।","pr":"ওয়া ইন্নাহূলিহুব্বিল খাইরি লাশাদীদ।"},{"i":9,"g":6155,"j":30,"ar":"۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ","bn":"সে কি জানে না, যখন কবরে যা আছে, তা উত্থিত হবে","pr":"আফালা-ইয়া‘লামুইযা-বু‘ছিরা মা-ফিল কুবূর।"},{"i":10,"g":6156,"j":30,"ar":"وَحُصِّلَ مَا فِى ٱلصُّدُورِ","bn":"এবং অন্তরে যা আছে, তা অর্জন করা হবে?","pr":"ওয়া হুসসিলা মা-ফিসসুদূর,"},{"i":11,"g":6157,"j":30,"ar":"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ","bn":"সেদিন তাদের কি হবে, সে সম্পর্কে তাদের পালনকর্তা সবিশেষ জ্ঞাত।","pr":"ইন্না রাব্বাহুম বিহিম ইয়াওমাইযিল্লাখাবীর।"}]}