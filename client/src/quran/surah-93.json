{"n":93,"bismillah":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ","ayahs":[{"i":1,"g":6080,"j":30,"ar":"وَٱلضُّحَىٰ","bn":"শপথ পূর্বাহ্নের,","pr":"ওয়াদদু হা-।"},{"i":2,"g":6081,"j":30,"ar":"وَٱلَّيْلِ إِذَا سَجَىٰ","bn":"শপথ রাত্রির যখন তা গভীর হয়,","pr":"ওয়াল্লাইলি ইযা-ছাজা-।"},{"i":3,"g":6082,"j":30,"ar":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","bn":"আপনার পালনকর্তা আপনাকে ত্যাগ করেনি এবং আপনার প্রতি বিরূপও হননি।","pr":"মা-ওয়াদ্দা‘আকা রাব্বুকা ওয়ামা-কালা-।"},{"i":4,"g":6083,"j":30,"ar":"وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ","bn":"আপনার জন্যে পরকাল ইহকাল অপেক্ষা শ্রেয়।","pr":"ওয়ালাল আ-খিরাতুখাইরুল্লাকা মিনাল ঊলা-।"},{"i":5,"g":6084,"j":30,"ar":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","bn":"আপনার পালনকর্তা সত্বরই আপনাকে দান করবেন, অতঃপর আপনি সন্তুষ্ট হবেন।","pr":"ওয়া লাছাওফা ইউ‘তীকা রাব্বুকা ফাতারদা-।"},{"i":6,"g":6085,"j":30,"ar":"أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ","bn":"তিনি কি আপনাকে এতীমরূপে পাননি? অতঃপর তিনি আশ্রয় দিয়েছেন।","pr":"আলাম ইয়াজিদকা ইয়াতীমান ফাআ-ওয়া-।"},{"i":7,"g":6086,"j":30,"ar":"وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ","bn":"তিনি আপনাকে পেয়েছেন পথহারা, অতঃপর পথপ্রদর্শন করেছেন।","pr":"ওয়া ওয়াজাদাকা দাল্লান ফাহাদা-।"},{"i":8,"g":6087,"j":30,"ar":"وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ","bn":"তিনি আপনাকে পেয়েছেন নিঃস্ব, অতঃপর অভাবমুক্ত করেছেন।","pr":"ওয়া ওয়াজাদাকা ‘আইলান ফাআগনা-।"},{"i":9,"g":6088,"j":30,"ar":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","bn":"সুতরাং আপনি এতীমের প্রতি কঠোর হবেন না;","pr":"ফাআম্মাল ইয়াতীমা ফালা-তাকহার।"},{"i":10,"g":6089,"j":30,"ar":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","bn":"সওয়ালকারীকে ধমক দেবেন না।","pr":"ওয়া আম্মাছ ছাইলা ফালা-তানহার।"},{"i":11,"g":6090,"j":30,"ar":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","bn":"এবং আপনার পালনকর্তার নেয়ামতের কথা প্রকাশ করুন।","pr":"ওয়া আম্মা-বিনি‘মাতি রাব্বিকা ফাহাদ্দিছ।"}]}